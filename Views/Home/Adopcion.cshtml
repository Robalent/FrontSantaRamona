@{
    ViewData["Title"] = "Adopcion";
    Layout = "~/Views/Shared/Layout1.cshtml";
}

<h1>Adoptar</h1>
<p>Selecciona un perro para ver más información:</p>

<div class="pets-grid">
    <a href="@Url.Action("InfoAdopcion", "Home", new { id = 1 })" class="pet-card">
        <img src="/images/adoptados/Labrador.luna.jpg" alt="Luna" />
        <div class="pet-info">Luna</div>
    </a>

    <a href="@Url.Action("InfoAdopcion", "Home", new { id = 2 })" class="pet-card">
        <img src="/images/adoptados/Beagle.max.jpg" alt="Max" />
        <div class="pet-info">Max</div>
    </a>
</div>

<style>
    .pets-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        justify-content: flex-start;
    }

    .pet-card {
        width: 400px;
        height: 400px;
        border-radius: 10px;
        background-color: #ffffff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        padding: 5px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
    }

        .pet-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
        }

        .pet-card img {
            width: 70%;
            height: 360px;
            object-fit: cover;
            border-radius: 5px;
            margin-bottom: 5px;
        }

    .pet-info {
        font-family: Nunito, sans-serif;
        font-weight: 800;
        font-size: 20px;
        margin-bottom: 6px;
        
    }
</style>
