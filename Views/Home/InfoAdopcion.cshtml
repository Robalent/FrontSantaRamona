@model FrontSantaRamona.AdopcionModels.Adopcion

@{
    ViewData["Title"] = "Detalle de Mascota";
    Layout = "~/Views/Shared/Layout1.cshtml";
}

@if (Model != null)
{
    <h1>Detalle de @Model.Nombre</h1>

    <div class="pet-detail-container">
        <!-- Foto a la izquierda -->
        <div class="pet-detail-image">
            <img src="@Model.Imagen" alt="@Model.Nombre" />
        </div>

        <!-- Info a la derecha -->
        <div class="pet-detail-info">
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Edad:</strong> @Model.Edad años</p>

            <p><strong>Raza:</strong> @(ViewBag.Razas != null && ((Dictionary<int, string>)ViewBag.Razas).ContainsKey(Model.Id_Raza) ? ((Dictionary<int, string>)ViewBag.Razas)[Model.Id_Raza] : "Desconocida")</p>

            <p><strong>Tamaño:</strong> @(ViewBag.Tamanos != null && ((Dictionary<int, string>)ViewBag.Tamanos).ContainsKey(Model.Id_Tamano) ? ((Dictionary<int, string>)ViewBag.Tamanos)[Model.Id_Tamano] : "Desconocido")</p>

            <p><strong>Historia:</strong> @Model.Historia</p>

            <a href="/FormularioAdopcion/@Model.Id_Animal" class="btn primary">Adoptar</a>
        </div>
    </div>

    <!-- Botón volver con estilo igual al botón Adoptar -->
    <button type="button" class="btn primary" onclick="history.back()"> Volver</button>

}
else
{
    <p>Mascota no encontrada.</p>
}


<style>
    .pet-detail-container {
        display: flex;
        max-width: 800px;
        margin: 30px auto;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

    .pet-detail-image img {
        width: 350px;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .pet-detail-info {
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start; /* mueve el texto hacia arriba */
        margin: 5px 0; /* arriba y abajo */
    }

    /* Media query dentro del <style> */
        @@media (max-width: 768px) {
        .pet-detail-container

    {
        flex-direction: column;
    }

    .pet-detail-image img {
        width: 100%;
        height: 250px;
    }

    .pet-detail-info {
        padding: 15px;
    }

        .btn-volver {
            background: var(--teal);
            color: white;
            box-shadow: none; /* quita la sombra negra */
            display: inline-grid;
            place-items: center;
            padding: 12px 18px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 800;
            letter-spacing: .4px;
            cursor: pointer;
            border: none;
            outline: none;
        }

            .btn-volver:hover {
                background-color: #009a84;
            }




</style>


