@{
	ViewData["Title"] = "Voluntariado";
    Layout = "~/Views/Shared/Layout1.cshtml";
}

 <style>

    h1{
        text-align:center;
        color: #C23A79;
    }
    /*Prueba Voluntariado*/
    .voluntariados-container {
        display: flex;
        flex-direction: column;
        gap: 40px; /* separación entre bloques */
        max-width: 1000px;
        margin: 0 auto;  /*centrar en la página */
        padding: 20px;
        background-color: var(--bg);
    }

    .voluntariado-item {
        display: flex;
        align-items: center;
        gap: 30px;
        border-radius:12px;
        width: 800px;
        background-color: #C23A79;
        margin-right: auto;
        margin-bottom: 0;
    }

        /* cuando la clase es "left": imagen izquierda */
        .voluntariado-item.par {
            flex-direction: row;
            margin-left:10px;
           
        }

        /* cuando la clase es "right": imagen derecha */
        .voluntariado-item.impar {
            flex-direction: row-reverse;
            margin-left:auto;
            margin-right:0px;
        }

    .img-voluntariado {
        width: 150px;
        height: 200px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        bottom:0;
    }

    .texto-voluntariado {
        flex: 1; /* ocupa todo el espacio sobrante */
        font-size: larger;
        line-height: 1.6;
        color: black;
        font-family: 'Times New Roman', Times, serif
    }
    
</style> 

@model List<PruebaFront.Models.VoluntariadoInfo>

<h1>Voluntariados </h1>
<p>Acá encontraras todos los requisitos necesarios que se deben cumplir para poder ser voluntario de Santa Ramona: </p>

<div class="voluntariados-container">
    @for (int i = 0; i < Model.Count; i++)
    {
        var v = Model[i];
        <div class="voluntariado-item @(i % 2 == 0 ? "par" : "impar")">
            <div class="imagen-voluntariado">
                <img src="@v.ImagenUrl" alt="Imagen voluntariado" class="img-voluntariado" />
            </div>
            <div class="texto-voluntariado">
                <p>@v.Texto</p>
            </div>
        </div>
    }
</div>

@section ExtraContent {
    <!-- CTA Final -->
    <section class="cta" aria-labelledby="cta-title">
        <div class="section-inner" style="text-align:center">
            <h2 id="cta-title">¿Querés ser parte de Santa Ramona?</h2>
            <p>Sumate como voluntario/a, casa de tránsito o colaborá con insumos.</p>
            <a class="btn primary" href="#">¡Sumate!</a>
        </div>
    </section>
}
