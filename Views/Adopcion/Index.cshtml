@model IEnumerable<FrontSantaRamona.AdopcionModels.Adopcion>

<h1>Adoptar</h1>
<div class="pets-grid">
    @foreach (var mascota in Model)
    {
        <div class="pet-card">
            <img src="@mascota.ImagenUrl" alt="@mascota.Nombre" />
            <div class="pet-info">
                <h3>@mascota.Nombre</h3>
                <p><strong>Edad:</strong> @mascota.Edad</p>
                <p><strong>Raza:</strong> @mascota.Raza</p>
                <p><strong>Estado:</strong> @mascota.Estado</p>
                <a href="/FormularioAdopcion/@mascota.Id" class="adopt-btn">Adoptar</a>
            </div>
        </div>
    }
</div>

<style>
    .pets-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .pet-card {
        border: 1px solid #ccc;
        border-radius: 10px;
        width: 200px;
        padding: 10px;
        text-align: center;
        box-shadow: 0px 2px 5px rgba(0,0,0,0.1);
    }

        .pet-card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 10px;
        }

    .adopt-btn {
        display: inline-block;
        padding: 5px 10px;
        margin-top: 5px;
        background-color: #28a745;
        color: white;
        text-decoration: none;
        border-radius: 5px;
    }

        .adopt-btn:hover {
            background-color: #218838;
        }
</style>
